# ── rail0 gateway ────────────────────────────────────────────────────
# Base URL of the rail0 gateway the app talks to.
# Local dev stack (rail0-gateway `bin/dev`): http://localhost:9292
GATEWAY_URL=http://localhost:9292

# Seller (merchant) wallet private key (0x-prefixed, 32 bytes). The storefront
# signs authorize/capture/void transactions and its SIWE login with this key.
# Must be registered as a payee wallet on the gateway and hold gas on the
# payment chain.
#
# There is NO buyer key here, by design: the buyer connects from the browser
# (MetaMask, or a pasted key that never leaves it). Only the seller's key
# lives server-side — the merchant's own backend signing its own txs.
SELLER_PRIVATE_KEY=

# Chain id embedded in the SIWE LOGIN message — NOT the chain payments run on
# (the agent picks that from payment_options). Must match the gateway's
# SIWE_CHAIN_ID policy, which defaults to 1 whatever the payment chains are.
# SIWE_CHAIN_ID=1

# ── AI ───────────────────────────────────────────────────────────────
# Anthropic API key used by the buyer agent (AI SDK provider).
ANTHROPIC_API_KEY=

# Model powering the agent.
# AI_MODEL=claude-sonnet-5

# ── Buyer agent → storefront ─────────────────────────────────────────
# Base URL the agent's tools call the storefront on. The agent runs in the eve
# service, outside any Next request, so it cannot derive this from the request:
# unset, it falls back to the Vercel production URL when deployed, and to
# http://localhost:3000 locally. Set it whenever the app runs on a different
# port/host (e.g. `pnpm dev -p 3001`) — otherwise the agent silently talks to
# a storefront that isn't there.
# SHOP_URL=http://localhost:3000

# ── Persistence (Vercel / production only) ───────────────────────────
# The order store falls back to a local file (.data/) in dev. On Vercel the
# filesystem is ephemeral: provision a Redis-compatible KV and set EITHER the
# Vercel KV pair or the Upstash pair — the store picks whichever is present.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
