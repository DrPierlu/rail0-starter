# ── rail0 gateway ────────────────────────────────────────────────────
# Base URL of the rail0 gateway the app talks to.
# Local dev stack (rail0-gateway `bin/dev`): http://localhost:9292
GATEWAY_URL=http://localhost:9292

# Seller (merchant) wallet private key (0x-prefixed, 32 bytes). The storefront
# signs authorize/capture/void transactions and its SIWE login with this key.
# Must be registered as a payee wallet on the gateway and hold gas on the
# payment chain.
#
SELLER_PRIVATE_KEY=

# The AGENT'S OWN WALLET — OPTIONAL, and the switch for autonomous buying.
#
# Set it and the agent buys on its own: no browser, no cards, no human. The key
# never leaves the server (it signs inside the checkout, in lib/buyer-signer) and
# there is no endpoint that signs anything else with it.
#
# Two things belong with that decision. The agent's channel (agent/channels/eve.ts)
# must not be anonymous, or anyone with the URL can direct the spending. And
# BUYER_MAX_ORDER below should be an amount you are willing to lose.
#
# Leave it unset for the normal case: the buyer is a person, connects MetaMask, and
# signs the two checkout cards themselves. A private key is never typed into the
# app — there is no field for one.
BUYER_PRIVATE_KEY=

# The two spending ceilings, as decimals in the payment stablecoin. Over either,
# the checkout asks a human to approve — an escalation, not a refusal: once
# approved it still buys by itself. 0 removes a ceiling. Both are ignored without
# BUYER_PRIVATE_KEY.
#
# They live here, next to the key, and NOT in the agent's instructions. That is
# deliberate: the model never holds the key, so it must not hold the limit on the
# key either. An instruction is read by something that also reads product
# descriptions written by strangers; a ceiling is not.
#
# BUYER_MAX_ORDER caps one order. BUYER_MAX_WINDOW caps the total over a rolling
# window, which is the part a per-order cap cannot do — four orders of 25 are each
# allowed and together are 100. The window total is read from the GATEWAY's record
# of what this wallet actually paid, so it survives "New conversation" (which
# starts a fresh agent session, and would reset anything counted in memory).
# BUYER_MAX_ORDER=25
# BUYER_MAX_WINDOW=100
# BUYER_WINDOW_HOURS=24

# Chain id embedded in the SIWE LOGIN message — NOT the chain payments run on
# (the agent picks that from payment_options). Must match the gateway's
# SIWE_CHAIN_ID policy, which defaults to 1 whatever the payment chains are.
# SIWE_CHAIN_ID=1

# ── Merchant dashboard ───────────────────────────────────────────────
# Shared secret guarding the merchant's own endpoints: the order list and the
# capture/void actions, which move real escrowed funds with the seller key.
# REQUIRED — those endpoints refuse every request while it is unset (they fail
# closed, and the error says so). The buyer's side needs nothing here.
#
# Generate one and paste the same value into /merchant to sign in (it is stored
# in an httpOnly cookie for 8 hours):
#
#   openssl rand -hex 32
#
# NOT NEXT_PUBLIC_: that prefix would inline it into the browser bundle and hand
# the credential to every visitor.
MERCHANT_TOKEN=

# ── Buyer agent access ───────────────────────────────────────────────
# Who may talk to the AGENT. `eve dev` needs none — eve's own localDev opens the
# channel on a local dev server — but a DEPLOYMENT refuses every chat request
# until this is set, which is the safe direction and the one to remember: a
# deploy that forgets it gets a chat that says 401, not one that serves the world.
#
# It matters most when BUYER_PRIVATE_KEY is set: talking to the agent is then
# spending, and the per-order approval that gates that spending is asked and
# answered over this same channel. Left open, that approval is answerable by
# anyone with the URL.
#
#   openssl rand -hex 32
#
# A different secret from MERCHANT_TOKEN on purpose: that one moves escrowed
# funds, this one directs an agent.
BUYER_TOKEN=

# ── AI ───────────────────────────────────────────────────────────────
# Anthropic API key used by the buyer agent (AI SDK provider).
ANTHROPIC_API_KEY=

# Model powering the agent.
# AI_MODEL=claude-sonnet-5

# ── Buyer agent → storefront ─────────────────────────────────────────
# Base URL the agent's tools call the storefront on. The agent runs in the eve
# service, outside any Next request, so it cannot derive this from the request:
# unset, it falls back to the Vercel production URL when deployed, and to
# http://localhost:4000 locally (the port `pnpm dev` binds). bin/dev derives it
# from that same port, so the two cannot drift. Set it by hand only when the app
# runs somewhere else — otherwise the agent silently talks to whatever answers on
# 4000, which in a full local rail0 stack could be another service entirely.
# SHOP_URL=http://localhost:4000

# ── Logging ──────────────────────────────────────────────────────────
# The server logs one line per gateway operation (authorize/capture/void, SIWE
# logins) and nothing for the polled read routes — see src/lib/log.ts. Set to
# `off` in a deployment that ships its own instrumentation; the default is on,
# because these lines exist for the moment something goes wrong, which is not a
# moment anyone has spent configuring logging for.
# STARTER_LOG=off

# ── Persistence ──────────────────────────────────────────────────────
# There is none, and that is deliberate. An order IS a rail0 payment (the gateway
# keeps it, lines included, in the payment's metadata) and the buyer's session lives
# in an httpOnly cookie for the one hop it is needed. So there is no order store and
# no signing stash to host: no Redis, no KV, no database, and nothing to provision
# before deploying to Vercel.
