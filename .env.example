# ── rail0 gateway ────────────────────────────────────────────────────
# Base URL of the rail0 gateway the app talks to.
# Local dev stack (rail0-gateway `bin/dev`): http://localhost:9292
GATEWAY_URL=http://localhost:9292

# Buyer wallet private key (0x-prefixed). The AI agent signs EIP-3009
# payment authorizations and its SIWE login with this key. Must hold the
# payment token (e.g. USDC) on the target testnet.
BUYER_PRIVATE_KEY=

# Seller (merchant) wallet private key (0x-prefixed). The storefront signs
# authorize/capture/void transactions and its SIWE login with this key.
# Must be registered as a payee wallet on the gateway and hold gas.
SELLER_PRIVATE_KEY=

# Chain id embedded in the SIWE login message. Must match the gateway's
# SIWE_CHAIN_ID policy (default 1).
# SIWE_CHAIN_ID=1

# ── AI ───────────────────────────────────────────────────────────────
# Anthropic API key used by the buyer agent (AI SDK provider).
ANTHROPIC_API_KEY=

# Model powering the agent.
# AI_MODEL=claude-sonnet-5

# ── App ──────────────────────────────────────────────────────────────
# Public URL of this app (the agent calls the storefront API through it).
# APP_URL=http://localhost:3000
