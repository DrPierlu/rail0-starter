#!/usr/bin/env bash
# Refresh the vendored @rail0/sdk tarball from the sibling rail0-ts checkout.
# Until the SDK is published to npm, vendor/ is this template's only source of
# it — so building and packing rail0-ts is not enough, the tarball has to land
# HERE and the file: dependency has to point at it. Run this after any rail0-ts
# change you want the starter to pick up, then commit the tarball.
set -euo pipefail
cd "$(dirname "$0")/.."

SDK_DIR=${RAIL0_TS_DIR:-../rail0-ts}
if [ ! -f "$SDK_DIR/package.json" ]; then
  echo "error: no rail0-ts checkout at $SDK_DIR (set RAIL0_TS_DIR to override)" >&2
  exit 1
fi

version=$(node -p "require('$SDK_DIR/package.json').version")
echo "Building @rail0/sdk $version from $SDK_DIR…"
(cd "$SDK_DIR" && pnpm install --silent && pnpm build)

rm -f vendor/rail0-sdk-*.tgz
(cd "$SDK_DIR" && pnpm pack --pack-destination "$OLDPWD/vendor" > /dev/null)

tarball="vendor/rail0-sdk-$version.tgz"
[ -f "$tarball" ] || { echo "error: expected $tarball after pack" >&2; exit 1; }

# `pnpm add` re-resolves the file: specifier, so it recomputes the tarball's integrity
# hash and updates package.json when the packed version changed. That part works.
#
# It does NOT reliably refresh node_modules, which is what this script exists for. The
# comment here used to claim the opposite — and that a plain install "even with --force"
# would keep serving the old contents. Measured on 2026-08-17, against a tarball verified
# to contain the new types: after `pnpm add` the extracted copy in node_modules was still
# the previous one, and `pnpm install --force` was what replaced it. Since the version
# never changes (the SDK is unpublished and always 1.0.0), nothing in the specifier tells
# pnpm the contents moved.
#
# So both run. --force is slow — it re-resolves the whole tree, ~2 minutes on a warm
# store — and that is the price of the guarantee: a starter built against a stale SDK
# fails in a way that looks like the STARTER is wrong, which is the worst outcome for a
# template someone is reading to learn from.
pnpm add "file:$tarball"
pnpm install --force
echo "Done — commit $tarball (and package.json / pnpm-lock.yaml if they changed)."
