#!/usr/bin/env bash
# Dev launcher: seeds .env.local on first run, installs dependencies, sanity-
# checks the gateway, then starts the Next.js dev server.
set -euo pipefail
cd "$(dirname "$0")/.."

if [ ! -f .env.local ]; then
  cp .env.example .env.local
  echo "Created .env.local from .env.example."
  echo "Fill in MERCHANT_PRIVATE_KEY, ANTHROPIC_API_KEY and MERCHANT_TOKEN, then run bin/dev again."
  exit 1
fi

# MERCHANT_TOKEN is checked like a key, not like an option: the merchant endpoints
# fail closed without it, so /merchant would load and then refuse every request.
#
# ABSENT counts as missing, not just empty. An .env.local created before a variable
# existed has no line for it at all, so a `KEY=\s*$` match alone passed the
# preflight and moved the failure to the first request — which is the one place
# this check exists to prevent.
missing=""
for key in MERCHANT_PRIVATE_KEY ANTHROPIC_API_KEY MERCHANT_TOKEN; do
  value=$(grep -E "^${key}=" .env.local | head -1 | cut -d= -f2- || true)
  # Strip surrounding whitespace so a "KEY= " line reads as unset.
  if [ -z "$(printf '%s' "$value" | tr -d '[:space:]')" ]; then
    missing="${missing}${key}"$'\n'
  fi
done
if [ -n "$missing" ]; then
  echo "Missing values in .env.local:"
  printf '%s' "$missing" | sed 's/^/  - /'
  echo "(generate a MERCHANT_TOKEN with \`openssl rand -hex 32\`)"
  exit 1
fi

if [ ! -d node_modules ]; then
  pnpm install
fi

gateway_url=$(grep -E '^RAIL0_GATEWAY_URL=' .env.local | cut -d= -f2-)
gateway_url=${gateway_url:-http://localhost:9292}
if ! curl -sf -m 3 "$gateway_url/health" > /dev/null 2>&1; then
  echo "warning: no rail0 gateway answering at $gateway_url"
  echo "         (local stack: run bin/dev in rail0-gateway first)"
fi

# Export the env for the eve agent service too: withEve() runs it as a
# sibling dev server, and only Next itself reads .env.local.
set -a
# shellcheck disable=SC1091
source .env.local
set +a

# The agent runs as a SEPARATE service, so it cannot derive the storefront origin
# from a request — it has to be told. Deriving SHOP_URL from the port we are about
# to bind keeps the two from drifting: an unset SHOP_URL used to mean the agent
# called localhost:3000, which in a full local rail0 stack is rail0-admin, so its
# shop calls reached a different application that answers them.
port=4000
export SHOP_URL="${SHOP_URL:-http://localhost:$port}"

# Nothing else has to be shared between the two processes: the app writes no files and
# keeps nothing between requests, so the eve service's per-build snapshot cwd
# (.eve/dev-runtime/snapshots/<id>/source) no longer matters. STARTER_DATA_DIR used to
# be exported here for the order store and the signature stash, and getting it wrong
# hung the checkout on "the sign-in signature has not arrived yet".

# Next silently moves to the next free port when this one is taken, which would
# leave SHOP_URL pointing at whoever holds it. Say so rather than let the agent
# talk to a stranger.
if lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1; then
  echo "warning: port $port is already in use — Next will pick another one,"
  echo "         and SHOP_URL ($SHOP_URL) will point at whatever holds $port."
  echo "         Free it, or run with SHOP_URL set to the port Next reports."
fi

echo "Storefront: $SHOP_URL  ·  buyer chat: $SHOP_URL/buyer"
exec pnpm dev
